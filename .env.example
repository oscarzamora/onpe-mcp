ONPE_SCRAPER_ROOT=C:/Users/ozamo/vscode/onpescraper
ONPE_SCRAPER_REPO_URL=https://github.com/oscarzamora/onpeescraper
ONPE_SOURCE_DIR=C:/Users/ozamo/vscode/onpescraper/source_data
ONPE_OUTPUT_DIR=C:/Users/ozamo/vscode/onpescraper/output
ONPE_DATA_DIR=C:/Users/ozamo/vscode/onpe-mcp/data
ONPE_LOG_LEVEL=INFO
ONPE_MAX_BATCH_SIZE=200
ONPE_CACHE_TTL_SECONDS=900
ONPE_GEO_QUERY_CACHE_TTL_SECONDS=300

# Bootstrap al iniciar: carga snapshot local de onpescraper si existe
ONPE_BOOTSTRAP_ON_STARTUP=true
ONPE_BOOTSTRAP_INCLUDE_VOTES=true

# Dependencia requerida: si ONPE_SCRAPER_ROOT no existe, se clona automáticamente desde ONPE_SCRAPER_REPO_URL.

# Auto-hidratación bajo demanda: consulta ONPE API para mesas faltantes en segmentos con baja cobertura
ONPE_AUTO_HYDRATE_ON_DEMAND=true
ONPE_AUTO_HYDRATE_MAX_MESAS=20

# Bootstrap desde ATuManera/Peru_elecciones2026 (CSV con 92,766 mesas presidenciales)
# Habilitar con true para forzarlo siempre; puede especificar ruta local para evitar descarga (~160MB)
# Nota: en primer arranque, si la BD sigue vacía tras bootstrap local, se usa este origen como fallback automático.
ONPE_ATU_MANERA_BOOTSTRAP=false
# ONPE_ATU_MANERA_CSV_PATH=/ruta/local/mesas_presidencial.csv

# Sincronización automática del catálogo extranjero bajo demanda
ONPE_AUTO_SYNC_FOREIGN_CATALOG_ON_DEMAND=true
